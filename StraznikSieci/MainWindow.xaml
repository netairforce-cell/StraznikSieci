<Window x:Class="StraznikSieci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Straznik Sieci - polaczenia, trasa pakietow, informacje o IP"
        Height="760" Width="1200" WindowStartupLocation="CenterScreen"
        Background="#1E1F24" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#26282E"/>
            <Setter Property="RowBackground" Value="#26282E"/>
            <Setter Property="AlternatingRowBackground" Value="#2B2E35"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="BorderBrush" Value="#3A3D45"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#33363E"/>
            <Setter Property="Foreground" Value="#BFC5D2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="TabMain" Background="#1E1F24" BorderThickness="0">
    <TabItem Header="Polaczenia">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Aktywne polaczenia TCP tego komputera" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnRefresh" Content="Odswiez" Click="BtnRefresh_Click"/>
            <CheckBox x:Name="ChkAuto" Content="Auto (co 3 s)" Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed"/>
            <CheckBox x:Name="ChkExternalOnly" Content="Tylko adresy z Internetu" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ChkHideListen" Content="Ukryj nasluchujace" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ChkLog" Content="Zapisuj nowe adresy do dziennika" IsChecked="True"/>
            <Button x:Name="BtnOpenLog" Content="Otworz folder dziennika" Background="#44474F" Click="BtnOpenLog_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="GridConnections" SelectionChanged="GridConnections_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Proces" Binding="{Binding ProcessName}" Width="150"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Lokalny" Binding="{Binding Local}" Width="170"/>
                <DataGridTextColumn Header="Zdalny adres" Binding="{Binding Remote}" Width="190"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="110"/>
                <DataGridTextColumn Header="Rodzaj" Binding="{Binding Kind}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="Adres IP / nazwa:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtTarget" Width="220" Margin="0,0,8,0" Padding="4,3"
                     Background="#26282E" Foreground="#E6E6E6" BorderBrush="#3A3D45"/>
            <Button x:Name="BtnInfo" Content="Informacje o IP" Click="BtnInfo_Click"/>
            <Button x:Name="BtnTrace" Content="Sledz trase (traceroute)" Click="BtnTrace_Click"/>
            <Button x:Name="BtnSaveReport" Content="Zapisz raport" Background="#44474F" Click="BtnSaveReport_Click"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="GridHops" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="GridHops_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Ttl}" Width="40"/>
                    <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="130"/>
                    <DataGridTextColumn Header="Nazwa hosta" Binding="{Binding HostName}" Width="*"/>
                    <DataGridTextColumn Header="Czas" Binding="{Binding Czas}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="TxtInfo" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     Background="#26282E" Foreground="#E6E6E6" BorderBrush="#3A3D45" Padding="8"/>
        </Grid>

        <TextBlock Grid.Row="5" x:Name="TxtStatus" Margin="0,8,0,0" Foreground="#9AA3B2" Text="Gotowe."/>
    </Grid>
    </TabItem>
    <TabItem Header="Sesje uzytkownikow">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Zalogowani uzytkownicy (konsola i zdalne RDP)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Odswiez" Click="BtnSessRefresh_Click"/>
                <Button Content="Wyslij komunikat do sesji" Click="BtnSessMsg_Click"/>
                <Button Content="Wyloguj sesje zdalna" Background="#B3402F" Click="BtnSessKick_Click"/>
            </StackPanel>
            <DataGrid Grid.Row="2" x:Name="GridSessions">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SessionId}" Width="50"/>
                    <DataGridTextColumn Header="Uzytkownik" Binding="{Binding User}" Width="160"/>
                    <DataGridTextColumn Header="Stacja" Binding="{Binding StationName}" Width="120"/>
                    <DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="120"/>
                    <DataGridTextColumn Header="Komputer zdalny" Binding="{Binding ClientName}" Width="150"/>
                    <DataGridTextColumn Header="Adres zdalny" Binding="{Binding ClientAddress}" Width="140"/>
                    <DataGridTextColumn Header="Ocena" Binding="{Binding Verdict}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </TabItem>
    <TabItem x:Name="TabAlerts" Header="Alerty">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Wykryte anomalie" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="ChkGuard" Content="Straz aktywna (skan co 5 s)" IsChecked="True"/>
                <Button Content="Zglos do CERT Polska (kopiuj raport + otworz formularz)" Click="BtnCert_Click"/>
                <Button Content="Zablokuj IP w zaporze" Background="#B3402F" Click="BtnBlock_Click"/>
            </StackPanel>
            <DataGrid Grid.Row="2" x:Name="GridAlerts">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Czas" Binding="{Binding TimeText}" Width="70"/>
                    <DataGridTextColumn Header="Poziom" Binding="{Binding Level}" Width="80"/>
                    <DataGridTextColumn Header="Zdarzenie" Binding="{Binding Title}" Width="330"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120"/>
                    <DataGridTextColumn Header="Szczegoly" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" x:Name="TxtGuardStatus" Margin="0,8,0,0" Foreground="#9AA3B2" Text="Straz uruchomiona."/>
        </Grid>
    </TabItem>
    </TabControl>
</Window>